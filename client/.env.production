# =============================================================================
# Production Environment Configuration (app='keeptabs')
# =============================================================================
# CRA automatically loads .env.production when running `npm run build`.
# All custom env vars must be prefixed with REACT_APP_ to reach the browser.
# =============================================================================

# --- AWS Region ---
REACT_APP_REGION=us-east-1

# --- API Gateway (Prod Stage) ---
REACT_APP_API_URL=https://16psjhr9ni.execute-api.us-east-1.amazonaws.com/prod/

# --- AWS Cognito Authentication ---
REACT_APP_COGNITO_USER_POOL_ID=us-east-1_MAXS6xo4n
REACT_APP_COGNITO_CLIENT_ID=6e2i01snasqfdamrne144ua0df

# --- Telemetry Emitter Credentials (publishable client identifiers) ---
# Enables the batched telemetry SDK (app='keeptabs') to POST screen/usage events.
REACT_APP_TELEMETRY_INGEST_URL=https://fwvr6vlznb.execute-api.us-east-1.amazonaws.com/prod/telemetry
REACT_APP_TELEMETRY_KEY_ID=emitter-prod-ed169e8759e9
