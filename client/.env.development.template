# =============================================================================
# AI Agent — Local Development Environment Template
# =============================================================================
# Copy this file to .env.development and fill in values.
# CRA automatically loads .env.development when running `npm start`.
# All custom env vars must be prefixed with REACT_APP_ to be accessible
# in the browser via process.env.REACT_APP_*.
#
# For personal overrides, create .env.development.local (gitignored).
# See AI_AGENT_LOCAL_DEV.md for full setup instructions.
# =============================================================================

# --- Browser Preference ---
BROWSER=safari

# --- AWS Region ---
REACT_APP_REGION=us-east-1

# --- API Gateway (Dev Stage) ---
# AI Agent endpoints on the dev stage of the existing KeepTabs API Gateway.
# Pattern: https://{api-id}.execute-api.{region}.amazonaws.com/{stage}/
REACT_APP_API_URL=https://16psjhr9ni.execute-api.us-east-1.amazonaws.com/dev/

# --- AWS Cognito Authentication ---
# Same user pool as production — auth tokens work across all API stages.
REACT_APP_COGNITO_USER_POOL_ID=us-east-1_MAXS6xo4n
REACT_APP_COGNITO_CLIENT_ID=<your-cognito-app-client-id>
